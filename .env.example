# Kopiere diese Datei nach .env.local und trage die Werte aus Supabase ein.
# .env.local wird nie committet.

# Supabase → Project Settings → API (bzw. "Data API"): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Supabase → Project Settings → API Keys: Publishable key (beginnt mit sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
