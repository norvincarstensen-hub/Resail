# Kopiere diese Datei nach .env.local und trage die Werte aus Supabase ein.
# .env.local wird nie committet.

# Supabase → Project Settings → API (bzw. "Data API"): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Supabase → Project Settings → API Keys: Publishable key (beginnt mit sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Abo (Stripe). Nur auf dem Server, niemals mit NEXT_PUBLIC_ beginnen! ---
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Stripe → Entwickler → API-Schlüssel → Geheimer Schlüssel (sk_test_... im Testmodus)
STRIPE_SECRET_KEY=
# Stripe → Entwickler → Webhooks → Endpunkt → Signaturgeheimnis (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe → Produktkatalog → Preise (price_...)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
